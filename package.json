{
  "name": "avalon-game",
  "version": "2.0.0",
  "description": "The Resistance: Avalon — role dealer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --testPathPatterns=tests/",
    "test:smoke": "node scripts/smoke-test.js",
    "test:all": "npm test && npm run test:smoke",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "bots": "node scripts/spawn-bots.js",
    "bots:imposter": "node scripts/spawn-imposter-bots.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "socket.io": "^4.8.3",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "playwright": "^1.61.0",
    "socket.io-client": "^4.8.3"
  }
}
